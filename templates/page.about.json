    "image-with-text-2": {
      "type": "image-with-text",
      "blocks": {
        "1661612015fe8eae74-0": {
          "type": "heading",
          "settings": {
            "title": "Meet the founder",
            "heading_font_class": "fs-heading-1-base"
          }
        },
        "6a4f5d32-f759-4a1c-942b-4c3e1f87ecc9": {
          "type": "text",
          "settings": {
            "text": "<p> “I spent many years working as an esthetician. Although I had access to the ‘best’ skincare products, I could never seem to manage my own skin struggles: extremely sensitive, reactive and breakout prone. I started creating my own with plant-based formulations and saw a drastic improvement in the health of my skin. Without much consideration, I quit my job, maxed out my credit cards and began a three year journey of intensive study into the world of natural cosmetics. My passion, vision and excitement for green beauty took hold. They have become deeply rooted in every part of Om.”</p>",
            "text_font_class": "fs-body-100"
          }
        },
        "ed03afa1-c573-41ea-bb92-39d1bb04b8de": {
          "type": "subheading",
          "settings": {
            "subheading": "– Kari Asselin, Founder",
            "subheading_font_class": "fs-heading-6-base"
          }
        }
      },
