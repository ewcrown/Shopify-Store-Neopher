{%- liquid
  assign section_padding = section.settings.section_padding
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_carousel = section.settings.mobile_carousel
  assign circle_diameter = section.settings.circle_diameter
  assign heading_tag = section.settings.heading_tag
  assign heading_alignment = section.settings.heading_alignment
-%}

{%- capture section_styles -%}
  <style>
    #shopify-section-{{ section.id }} {
      --circle-diameter: {{ circle_diameter }}px;
      --desktop-columns: {{ desktop_columns }};
      --column-gap: {{ section.settings.column_gap }}px;
      background-color: {{ section.settings.bg_color }};
    }

    .circle-categories__grid {
      display: grid;
      grid-template-columns: repeat(var(--desktop-columns), 1fr);
      gap: var(--column-gap);
      justify-items: center;
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
    }

    .circle-categories__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: inherit;
      width: 100%;
      text-align: center;
    }

    .circle-categories__image-wrapper {
      width: var(--circle-diameter);
      height: var(--circle-diameter);
      border-radius: 50%;
      overflow: hidden;
      margin-bottom: 12px;
      position: relative;
      transition: transform 0.3s ease;
      background: #f4f4f4;
      border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      {% if section.settings.enable_shadow %}
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      {% endif %}
    }

    .circle-categories__item:hover .circle-categories__image-wrapper {
      {% if section.settings.enable_zoom %}
        transform: scale(1.05);
      {% endif %}
    }

    .circle-categories__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .circle-categories__label {
      font-size: {{ section.settings.label_font_size }}px;
      color: {{ section.settings.label_color }};
      font-weight: {{ section.settings.label_weight }};
      text-transform: {{ section.settings.label_transform }};
      margin: 0;
      line-height: 1.2;
    }

    .circle-categories__heading {
      margin-bottom: {{ section.settings.heading_margin_bottom }}px;
      text-align: {{ heading_alignment }};
    }

    @media (max-width: 719px) {
      {% if mobile_carousel %}
        .circle-categories__grid {
          display: flex;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
          gap: 15px;
          padding: 0 20px 20px;
          justify-content: flex-start;
          margin: 0 -20px;
        }
        .circle-categories__item {
          flex: 0 0 calc(100% / {{ section.settings.mobile_columns_slider }} - 20px);
          scroll-snap-align: start;
        }
        /* Hide scrollbar */
        .circle-categories__grid::-webkit-scrollbar {
          display: none;
        }
        .circle-categories__grid {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
      {% else %}
        .circle-categories__grid {
          grid-template-columns: repeat(2, 1fr);
          padding: 0 20px;
        }
      {% endif %}
      
      #shopify-section-{{ section.id }} {
        --circle-diameter: {{ section.settings.circle_diameter_mobile }}px;
      }
    }
  </style>
{%- endcapture -%}

{{ section_styles }}

<div class="circle-categories section {{ section_padding }}" id="circle-categories-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="circle-categories__heading ff-heading fs-heading-3-base">
        {{ section.settings.heading }}
      </{{ heading_tag }}>
    {%- endif -%}

    <div class="circle-categories__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="circle-categories__item" {{ block.shopify_attributes }}>
          <div class="circle-categories__image-wrapper">
            {%- if block.settings.image != blank -%}
              {% render 'image',
                image: block.settings.image,
                wrapper_class: 'circle-categories__image',
                aspect_ratio: 'square',
                sizes: '200px',
                src_set_type: 'thumbnail'
              %}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'circle-categories__image' }}
            {%- endif -%}
          </div>
          {%- if block.settings.label != blank -%}
            <p class="circle-categories__label">{{ block.settings.label }}</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Circle Categories",
  "tag": "section",
  "class": "circle-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Categories"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        {"value": "h1", "label": "H1"},
        {"value": "h2", "label": "H2"},
        {"value": "h3", "label": "H3"}
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading Bottom Margin",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Columns in Row",
      "options": [
        {"value": "2", "label": "2"},
        {"value": "3", "label": "3"},
        {"value": "4", "label": "4"},
        {"value": "5", "label": "5"},
        {"value": "6", "label": "6"}
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Enable Mobile Carousel",
      "default": true
    },
    {
       "type": "select",
       "id": "mobile_columns_slider",
       "label": "Items visible on mobile (partial reveal)",
       "options": [
         {"value": "1.5", "label": "1.5 items"},
         {"value": "2.5", "label": "2.5 items"},
         {"value": "3.5", "label": "3.5 items"}
       ],
       "default": "2.5"
    },
    {
      "type": "header",
      "content": "Circle Styling"
    },
    {
      "type": "range",
      "id": "circle_diameter",
      "label": "Desktop Circle Diameter",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "circle_diameter_mobile",
      "label": "Mobile Circle Diameter",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable Hover Zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable Subtle Shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#eeeeee"
    },
    {
      "type": "header",
      "content": "Label Styling"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Label Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label Weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "600", "label": "Semi-bold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "label_transform",
      "label": "Label Transform",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section Padding",
      "options": [
        {"value": "section--vertical-padding-top-bottom", "label": "Top & Bottom"},
        {"value": "section--vertical-padding-top-only", "label": "Top Only"},
        {"value": "section--vertical-padding-bottom-only", "label": "Bottom Only"},
        {"value": "section--vertical-padding-none", "label": "None"}
      ],
      "default": "section--vertical-padding-top-bottom"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Circle Categories",
      "blocks": [
        {"type": "category", "settings": {"label": "Cleansers"}},
        {"type": "category", "settings": {"label": "Treatments"}},
        {"type": "category", "settings": {"label": "Moisturizers"}}
      ]
    }
  ]
}
{% endschema %}
