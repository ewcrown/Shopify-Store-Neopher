    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section Padding",
      "options": [
        { "value": "section--vertical-padding-none", "label": "None" },
        { "value": "section--vertical-padding-top-bottom", "label": "Top & Bottom" }
      ],
      "default": "section--vertical-padding-top-bottom"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Step-by-step Routine"
    }
  ]
}
