{%- liquid
  assign desktop_video = section.settings.desktop_video
  assign mobile_video = section.settings.mobile_video | default: desktop_video
  assign desktop_video = desktop_video | default: mobile_video

  assign video_id = 'video-section-' | append: section.id
  assign mobile_video_id = video_id | append: '-mobile'

  assign autoplay = section.settings.autoplay
  assign loop = section.settings.loop
  assign controls = section.settings.controls
  assign mute = section.settings.mute

  if autoplay
    assign mute = true
  endif
-%}

<div
  id="DynamicVideo-{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.section_bg_color }};"
>
  <div class="{% if section.settings.full_width %}page-width--full force-full-width{% else %}page-width{% endif %}">
    <div class="video-section-container" style="--video-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}">

      {%- if desktop_video != blank -%}
        <div class="video-wrapper desktop-video {% if mobile_video != blank and mobile_video != desktop_video %}hide-on-mobile{% endif %}">
          {{ desktop_video
            | video_tag:
              id: video_id,
              class: 'video-element',
              image_size: '2000x',
              autoplay: autoplay,
              loop: loop,
              controls: controls,
              muted: mute,
              preload: 'metadata',
              playsinline: true
          }}
          <div class="video-overlay"></div>
          <button type="button" class="dv-sound-btn" aria-label="Toggle sound" data-video-id="{{ video_id }}">
            <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <svg class="icon-sound" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          </button>
        </div>
      {%- endif -%}

      {%- if mobile_video != blank and mobile_video != desktop_video -%}
        <div class="video-wrapper mobile-video hide-on-desktop">
          {{ mobile_video
            | video_tag:
              id: mobile_video_id,
              class: 'video-element',
              image_size: '1000x',
              autoplay: autoplay,
              loop: loop,
              controls: controls,
              muted: mute,
              preload: 'metadata',
              playsinline: true
          }}
          <div class="video-overlay"></div>
          <button type="button" class="dv-sound-btn" aria-label="Toggle sound" data-video-id="{{ mobile_video_id }}">
            <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <svg class="icon-sound" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          </button>
        </div>
      {%- endif -%}

      {%- if desktop_video == blank and mobile_video == blank -%}
          <div class="video-wrapper placeholder-video">
             {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
             <div class="video-overlay"></div>
          </div>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
      <div class="video-content content-{{ section.settings.content_position }}">
        <div class="video-content-inner" style="text-align: {{ section.settings.text_alignment }};">
          {%- if section.settings.heading != blank -%}
            <h2 class="video-heading {{ section.settings.heading_size }}" style="color: {{ section.settings.text_color }};">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="video-text rte" style="color: {{ section.settings.text_color }};">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="button {{ section.settings.button_style }}">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
      width: 100%;
      margin: 0 !important;
      padding: 0 !important;
      max-width: none !important;
  }

  #DynamicVideo-{{ section.id }} {
    margin: 0 !important;
    width: 100%;
  }

  .section-{{ section.id }}-padding {
    {%- if section.settings.full_width -%}
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    {%- else -%}
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      {%- unless section.settings.full_width -%}
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- endunless -%}
    }
  }

  {%- if section.settings.full_width -%}
    .force-full-width {
      max-width: 100% !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }
  {%- endif -%}

  .video-section-container {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    padding-bottom: {{ section.settings.video_height_desktop }}%;
  }

  @media screen and (max-width: 749px) {
    .video-wrapper {
      padding-bottom: {{ section.settings.video_height_mobile }}%;
    }
  }

  .video-element {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #f4f4f4;
  }

  .video-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #000;
    opacity: var(--video-overlay-opacity);
    pointer-events: none;
  }

  .hide-on-mobile { display: none; }
  .hide-on-desktop { display: block; }

  @media screen and (min-width: 750px) {
    .hide-on-mobile { display: block; }
    .hide-on-desktop { display: none; }
  }

  .video-content {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    padding: 2rem;
    pointer-events: none;
  }

  .video-content-inner {
    max-width: {{ section.settings.content_max_width }}px;
    width: 100%;
    pointer-events: auto;
  }

  .content-top-left { justify-content: flex-start; align-items: flex-start; }
  .content-top-center { justify-content: center; align-items: flex-start; }
  .content-top-right { justify-content: flex-end; align-items: flex-start; }
  .content-middle-left { justify-content: flex-start; align-items: center; }
  .content-middle-center { justify-content: center; align-items: center; }
  .content-middle-right { justify-content: flex-end; align-items: center; }
  .content-bottom-left { justify-content: flex-start; align-items: flex-end; }
  .content-bottom-center { justify-content: center; align-items: flex-end; }
  .content-bottom-right { justify-content: flex-end; align-items: flex-end; }

  .video-heading { margin: 0 0 1rem; }
  .video-text { margin-bottom: 2rem; }
  .video-text p { margin: 0; }

  @media screen and (max-width: 749px) {
    .video-heading.h0 { font-size: 3.2rem; }
    .video-heading.h1 { font-size: 2.6rem; }
    .video-heading.h2 { font-size: 2rem; }
  }

  {%- if section.settings.full_width -%}
    .page-width--full { max-width: 100%; padding: 0; }
  {%- endif -%}

  /* ── Sound Toggle Button ── */
  #DynamicVideo-{{ section.id }} .dv-sound-btn {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 10;
    transition: background 0.2s, transform 0.2s;
  }
  #DynamicVideo-{{ section.id }} .dv-sound-btn:hover {
    background: rgba(0, 0, 0, 0.75);
    transform: scale(1.08);
  }
</style>

<script>
(function() {
  function initSoundBtns() {
    var section = document.getElementById('DynamicVideo-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('.dv-sound-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var videoId = btn.getAttribute('data-video-id');
        var video = document.getElementById(videoId);
        if (!video) return;

        if (video.muted) {
          video.muted = false;
          video.volume = 1;
          btn.querySelector('.icon-muted').style.display = 'none';
          btn.querySelector('.icon-sound').style.display = 'block';
        } else {
          video.muted = true;
          btn.querySelector('.icon-muted').style.display = 'block';
          btn.querySelector('.icon-sound').style.display = 'none';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSoundBtns);
  } else {
    initSoundBtns();
  }

  // Shopify theme editor live reload support
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.querySelector('#DynamicVideo-{{ section.id }}')) {
      initSoundBtns();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Dynamic Video",
  "settings": [
    {
      "type": "header",
      "content": "Video Files"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop Video",
      "info": "Select a Shopify-hosted video for desktop."
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video (Optional)",
      "info": "Select a separate video for mobile. If blank, desktop video will be used."
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Autoplay will automatically mute the video."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mute",
      "label": "Mute Video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show Controls",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": true
    },
    {
      "type": "range",
      "id": "video_height_desktop",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Desktop Height (Aspect Ratio)",
      "info": "E.g., 56.25% for 16:9 ratio.",
      "default": 56
    },
    {
      "type": "range",
      "id": "video_height_mobile",
      "min": 20,
      "max": 150,
      "step": 2,
      "unit": "%",
      "label": "Mobile Height (Aspect Ratio)",
      "info": "E.g., 100% for square, 133.33% for 3:4 vertical.",
      "default": 132
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video Banner"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share information about your brand with customers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "button button--primary", "label": "Primary" },
        { "value": "button button--secondary", "label": "Secondary" },
        { "value": "button button--tertiary", "label": "Tertiary" }
      ],
      "default": "button button--primary"
    },
    {
      "type": "header",
      "content": "Content Styling & Position"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 600
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Dynamic Video"
    }
  ]
}
{% endschema %}