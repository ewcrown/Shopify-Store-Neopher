{% comment %}
  Custom Category Grid Section by Expert Dev (Mobile Fix)
  Based on client provided mockup for desktop and mobile.
  Features: CSS Grid layout, fully customizable settings, responsive design, standalone color settings.
{% endcomment %}

<div class="section-{{ section.id }}-padding custom-grid-wrapper" style="background-color: {{ section.settings.section_bg_color }};">
  <div class="page-width">
    {% if section.settings.title != blank %}
      {% comment %}
        Heading uses the theme's default heading font family implicitly through the h1/h2/h0 classes,
        but we override the color based on settings.
      {% endcomment %}
      <h2 class="section-title {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }}; margin-bottom: {{ section.settings.heading_margin_bottom }}px; text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.title | escape }}
      </h2>
    {% endif %}

    <div class="custom-cat-grid-container">
      {%- for block in section.blocks -%}
        <div class="cat-grid-item item-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="cat-grid-link">
            <div class="cat-image-wrapper" style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}">
              {% if block.settings.image != blank %}
                {%- capture sizes -%}
                  (min-width: 990px) {% if forloop.first %}50vw{% else %}25vw{% endif %}, (min-width: 750px) {% if forloop.first %}50vw{% else %}25vw{% endif %}, 100vw
                {%- endcapture -%}
                {{
                  block.settings.image
                  | image_url: width: 1500
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '375, 550, 750, 1100, 1500',
                    class: 'cat-grid-image zoom-effect'
                }}
              {% else %}
                {% comment %} Placeholder if no image is selected {% endcomment %}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg cat-grid-image' }}
              {% endif %}
               <div class="cat-overlay"></div>
            </div>
            <div class="cat-content">
              {% if block.settings.heading != blank %}
                <h3 class="cat-heading" style="color: {{ block.settings.text_color }}">
                  {{ block.settings.heading | escape }}
                </h3>
              {% endif %}
            </div>
          </a>
        </div>
      {%- else -%}
        {% comment %} Empty state placeholders {% endcomment %}
        {% for i in (1..3) %}
           <div class="cat-grid-item item-{{ i }}">
             <div class="cat-image-wrapper" style="--overlay-opacity: 0.3">
                 {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg cat-grid-image' }}
                 <div class="cat-overlay"></div>
             </div>
             <div class="cat-content"><h3 class="cat-heading" style="color: #fff">Category {{ i }}</h3></div>
           </div>
        {% endfor %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  /* --- General Section Styles --- */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    max-width:1067px;
    margin:auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Heading Style */
  .section-title {
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 0;
    /* We rely on theme's default heading font here */
  }

  /* --- The Grid Layout --- */
  .custom-cat-grid-container {
    display: grid;
    grid-template-columns: 1fr; /* Mobile first: single column stack */
    gap: {{ section.settings.grid_gap }}px;
  }
  h2.section-title.h1 {
    font-size: 48px;
    font-weight: 600;
    font-family: 'Fraunces', sans-serif;
}

  /* --- Mobile Layout Specifics (The Fix) --- */
  @media screen and (max-width: 749px) {
      /* First item is portrait */
      .item-1 {
          aspect-ratio: 3 / 4;
      }
      /* Second and third items are landscape */
      .item-2, .item-3 {
          aspect-ratio: 16 / 9; /* Makes them wider than tall */
      }
  }


  /* --- Desktop Layout (Min-width 750px) --- */
  @media screen and (min-width: 750px) {
    .custom-cat-grid-container {
      grid-template-columns: 1fr 1fr; /* Two equal columns */
      grid-template-rows: repeat(2, 1fr); /* Two equal rows */
      /* Define areas to map the items correctly */
      grid-template-areas:
        "left-col right-top"
        "left-col right-bottom";
      /* Adjust height ratios based on mockup - Overall section ratio */
      aspect-ratio: 16 / 9;
    }

    /* Assigning items to grid areas based on their order */
    .item-1 { grid-area: left-col; aspect-ratio: auto; /* Reset aspect ratio from mobile */ }
    .item-2 { grid-area: right-top; aspect-ratio: auto; }
    .item-3 { grid-area: right-bottom; aspect-ratio: auto; }
  }

  /* --- Item Styling --- */
  .cat-grid-item {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_corner_radius }}px;
    height: 100%;
    width: 100%;
  }

  .cat-grid-link {
    display: block;
    height: 100%;
    width: 100%;
    text-decoration: none;
  }

  .cat-image-wrapper {
    position: relative;
    height: 100%;
    width: 100%;
  }

  .cat-grid-image {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures image fills the box without stretching */
    object-position: center;
    transition: transform 0.5s ease;
  }

  /* Zoom effect on hover (optional aesthetic touch) */
  @media screen and (min-width: 750px) {
    .cat-grid-item:hover .zoom-effect {
      transform: scale(1.05);
    }
  }

  /* Dark Overlay */
  .cat-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #000;
    opacity: var(--overlay-opacity); /* Controlled by setting */
    transition: opacity 0.3s ease;
    pointer-events: none; /* Ensures clicks go through to the link */
  }

  /* --- Content Text Styling --- */
  .cat-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* Perfect center alignment */
    text-align: center;
    width: 90%;
    z-index: 2;
    pointer-events: none; /* Ensures clicks go through to the link */
  }

  .cat-heading {
    margin: 0;
    /* Uses theme's default heading font */
    font-weight: bold;
    font-size: 36px;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3); /* Better readability */
    font-family:'Fraunces',serif;
  }

  /* Responsive Font Sizes */
   @media screen and (min-width: 768px) {
      .cat-heading { font-size: 36px; }
   }
   @media screen and (min-width: 990px) {
      .cat-heading { font-size: 36px; }
   }
   @media screen and (max-width:767px){
    h2.section-title.h1 {
    font-size: 28px;
    white-space:nowrap;
    }
    .page-width h2.section-title.h1{
      margin-bottom:30px !important;
    }
    .cat-heading{
      font-size:26px;
    }
    .page-width .custom-cat-grid-container{
      grid-gap:24px !important;
    }
    .section-{{ section.id }}-padding{
      padding-right:3px;
      padding-left:3px;
    }
   }

{% endstyle %}

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "SHOP BY CATEGORY",
      "label": "Section Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "default": "center",
      "label": "Heading Alignment"
    },
    {
       "type": "color",
       "id": "heading_color",
       "label": "Heading Color",
       "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Heading Bottom Margin",
      "default": 32
    },
    {
      "type": "header",
      "content": "Grid Layout Settings"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Spacing)",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Colors & Padding"
    },
     {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category_block",
      "name": "Category Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Collection Name",
          "label": "Heading Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "header",
          "content": "Styling"
        },
         {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Image Overlay Opacity",
          "info": "Darkens image to make text readable.",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category_block" },
        { "type": "category_block" },
        { "type": "category_block" }
      ]
    }
  ]
}
{% endschema %}