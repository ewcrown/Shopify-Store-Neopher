{%- liquid
  assign section_id = 'stl-' | append: section.id
  assign collection = collections[section.settings.collection]
  assign image_alignment = section.settings.image_alignment
-%}

<div
  id="{{ section_id }}"
  class="
    shop-the-look
    section
    section--divider-{{ section.settings.divider_style }}
    {{ section.settings.section_padding }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
    {% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="shop-the-look"
  style="
    --stl-bg: {{ section.settings.background_color }};
    --stl-text-color: {{ section.settings.text_color }};
    --stl-btn-bg: {{ section.settings.button_background }};
    --stl-btn-color: {{ section.settings.button_text_color }};
    --stl-column-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="shop-the-look__inner">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="shop-the-look__header section-introduction ta-{{ section.settings.header_alignment }}">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="shop-the-look__heading ff-heading fs-heading-3-base section-introduction__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="shop-the-look__subheading ff-body fs-body-100 rte section-introduction__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Main Content Layout ── {%- endcomment -%}
    <div class="shop-the-look__grid shop-the-look__grid--align-{{ image_alignment }}">
      
      {%- comment -%} Left/Right Featured Image {%- endcomment -%}
      <div class="shop-the-look__image-col">
        <div class="shop-the-look__image-container" style="padding-top: {{ 1 | divided_by: section.settings.image_aspect_ratio | times: 100 }}%;">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 768px) 50vw, 100vw',
              class: 'shop-the-look__image'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Product Slider Column {%- endcomment -%}
      <div class="shop-the-look__slider-col">
        <div class="shop-the-look__slider-wrap">
          {%- if collection != blank and collection.products_count > 0 -%}
            <div class="shop-the-look__swiper swiper">
              <div class="swiper-wrapper">
                {%- for product in collection.products limit: 12 -%}
                  <div class="swiper-slide shop-the-look__slide">
                    <div class="stl-card">
                      <a href="{{ product.url }}" class="stl-card__image-link">
                        <div class="stl-card__image-wrap">
                          <img
                            src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
                            alt="{{ product.title | escape }}"
                            class="stl-card__image"
                            loading="lazy"
                          >
                        </div>
                      </a>
                      <div class="stl-card__info">
                        <a href="{{ product.url }}" class="stl-card__title ff-heading fs-body-100">{{ product.title }}</a>
                        <div class="stl-card__price ff-body fs-body-75">
                          {%- if product.compare_at_price > product.price -%}
                            <s class="stl-card__compare-price">{{ product.compare_at_price | money }}</s>
                          {%- endif -%}
                          <span class="stl-card__sale-price">{{ product.price | money }}</span>
                        </div>
                        <a href="{{ product.url }}" class="stl-card__btn btn {{ section.settings.button_style }}">
                          View Product
                        </a>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
              
              {%- comment -%} Navigation {%- endcomment -%}
              <button type="button" class="stl-arrow stl-arrow--prev" aria-label="Previous">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" class="stl-arrow stl-arrow--next" aria-label="Next">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
              <div class="stl-pagination"></div>
            </div>
          {%- else -%}
            <div class="shop-the-look__empty">
              <p>Select a collection to display products.</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #{{ section_id }} {
    background-color: var(--stl-bg);
    color: var(--stl-text-color);
  }
  .shop-the-look__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 var(--page-gutter, 20px);
  }
  .shop-the-look__grid {
    display: flex;
    gap: var(--stl-column-gap);
    align-items: center;
    flex-wrap: wrap;
  }
  .shop-the-look__grid--align-right {
    flex-direction: row-reverse;
  }
  .shop-the-look__image-col, .shop-the-look__slider-col {
    flex: 1 1 calc(50% - (var(--stl-column-gap) / 2));
    min-width: 300px;
  }
  .shop-the-look__image-container {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }
  .shop-the-look__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  
  /* Slider Card */
  .shop-the-look__slider-wrap {
    max-width: 450px;
    margin: 0 auto;
    position: relative;
    padding: 0 50px;
  }
  .stl-card {
    background: transparent;
    text-align: center;
    padding: 10px;
    max-width: 320px;
    margin: 0 auto;
  }
  .stl-card__image-link {
    display: block;
    margin-bottom: 12px;
  }
  .stl-card__image-wrap {
    position: relative;
    padding-top: 100%;
    overflow: hidden;
    border-radius: 4px;
    background: transparent;
  }
  .stl-card__image {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }
  .stl-card__title {
    display: block;
    margin-bottom: 4px;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    font-size: 14px;
  }
  .stl-card__price {
    margin-bottom: 15px;
    font-size: 13px;
  }
  .stl-card__compare-price {
    opacity: 0.6;
    margin-right: 8px;
  }
  .stl-card__btn {
    display: inline-block;
    width: auto;
    min-width: 140px;
    background: var(--stl-btn-bg);
    color: var(--stl-btn-color);
    text-decoration: none;
    padding: 8px 20px;
    font-size: 12px;
    border-radius: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Controls */
  .stl-arrow {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    position: absolute;
    top: 35%;
    transform: translateY(-50%);
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    color: #222;
  }
  .stl-arrow--prev { left: 0; }
  .stl-arrow--next { right: 0; }
  
  .stl-pagination {
    margin-top: 25px;
    position: static !important;
    text-align: center;
    display: flex;
    justify-content: center;
  }
  .stl-pagination .swiper-pagination-bullet {
    background: #222;
    opacity: 0.2;
  }
  .stl-pagination .swiper-pagination-bullet-active {
    background: #4E95C7 !important;
    opacity: 1;
  }

  .stl-arrow:hover { 
    background: #4E95C7 !important;
    color: #fff !important;
    border-color: #4E95C7 !important;
  }

  @media (max-width: 767px) {
    .shop-the-look__grid {
      flex-direction: column !important;
      gap: 30px;
    }
    .shop-the-look__image-col, .shop-the-look__slider-col {
      flex: 1 1 100%;
      width: 100%;
    }
  }
</style>

<script>
(function() {
  function initSTL(section) {
    const swiperEl = section.querySelector('.shop-the-look__swiper');
    if (!swiperEl) return;

    const initSwiper = (module) => {
      const { Swiper, Navigation, Pagination } = module;
      new Swiper(swiperEl, {
        modules: [Navigation, Pagination],
        slidesPerView: 1,
        spaceBetween: 20,
        loop: true,
        navigation: {
          prevEl: section.querySelector('.stl-arrow--prev'),
          nextEl: section.querySelector('.stl-arrow--next'),
        },
        pagination: {
          el: section.querySelector('.stl-pagination'),
          clickable: true,
        }
      });
    };

    if (window.flu && flu.chunks && flu.chunks.swiper) {
      import(flu.chunks.swiper).then(initSwiper);
    } else if (window.Swiper) {
       initSwiper({ 
         Swiper: window.Swiper, 
         Navigation: window.Navigation, 
         Pagination: window.Pagination 
       });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-section-type="shop-the-look"]').forEach(initSTL);
  });

  document.addEventListener('shopify:section:load', (e) => {
    if (e.target.dataset.sectionType === 'shop-the-look') initSTL(e.target);
  });
})();
</script>

{% schema %}
{
  "name": "Shop the Look",
  "tag": "section",
  "class": "shop-the-look-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "l", "label": "Left" },
        { "value": "c", "label": "Center" },
        { "value": "r", "label": "Right" }
      ],
      "default": "c"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Image"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1.0", "label": "Square (1:1)" },
        { "value": "0.8", "label": "Portrait (4:5)" },
        { "value": "0.75", "label": "Portrait (3:4)" },
        { "value": "0.66", "label": "Portrait (2:3)" },
        { "value": "1.25", "label": "Landscape (5:4)" },
        { "value": "1.33", "label": "Landscape (4:3)" },
        { "value": "1.5", "label": "Landscape (3:2)" }
      ],
      "default": "1.0"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" }
      ],
      "default": "btn--primary"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section Padding",
      "options": [
        { "value": "section--vertical-padding-none", "label": "None" },
        { "value": "section--vertical-padding-top-bottom", "label": "Top & Bottom" }
      ],
      "default": "section--vertical-padding-top-bottom"
    }
  ],
  "presets": [
    {
      "name": "Shop the Look",
      "category": "Custom"
    }
  ]
}
{% endschema %}
