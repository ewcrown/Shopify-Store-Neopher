{%- liquid
  assign section_id = section.id
  assign show_section = collection.metafields.custom.show_collection_tabs.value
  assign alignment = section.settings.alignment
  assign tabs_gap = section.settings.tabs_gap
  assign tabs_gap_mobile = section.settings.tabs_gap_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign section_bg = section.settings.section_bg
  assign show_border_bottom = section.settings.show_border_bottom
  assign border_color = section.settings.border_color
  assign font_size = section.settings.font_size
  assign font_size_mobile = section.settings.font_size_mobile
  assign font_weight = section.settings.font_weight
  assign letter_spacing = section.settings.letter_spacing
  assign text_transform = section.settings.text_transform
  assign tab_padding_v = section.settings.tab_padding_v
  assign tab_padding_h = section.settings.tab_padding_h
  assign tab_padding_v_mobile = section.settings.tab_padding_v_mobile
  assign tab_padding_h_mobile = section.settings.tab_padding_h_mobile
  assign border_radius = section.settings.border_radius
  assign show_tab_border = section.settings.show_tab_border
  assign border_width = section.settings.border_width
  assign tab_text_color = section.settings.tab_text_color
  assign tab_bg_color = section.settings.tab_bg_color
  assign tab_border_color = section.settings.tab_border_color
  assign active_text_color = section.settings.active_text_color
  assign active_bg_color = section.settings.active_bg_color
  assign active_border_color = section.settings.active_border_color
  assign active_font_weight = section.settings.active_font_weight
  assign container_width = section.settings.container_width
  assign show_divider = section.settings.show_divider
  assign divider_color = section.settings.divider_color
  assign divider_height = section.settings.divider_height
-%}

{%- if show_section -%}

<style>
  #coll-tabs-{{ section_id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    background-color: {{ section_bg }};
    {% if show_border_bottom %}border-bottom: {{ divider_height }}px solid {{ border_color }};{% endif %}
  }

  #coll-tabs-{{ section_id }} .coll-tabs__inner {
    justify-content: {{ alignment }};
    gap: {{ tabs_gap }}px;
    max-width: {{ container_width }}px;
  }

  #coll-tabs-{{ section_id }} .coll-tabs__item {
    font-size: {{ font_size }}px;
    font-weight: {{ font_weight }};
    color: {{ tab_text_color }};
    background-color: {{ tab_bg_color }};
    border-style: solid;
    border-width: {% if show_tab_border %}{{ border_width }}px{% else %}0{% endif %};
    border-color: {{ tab_border_color }};
    border-radius: {{ border_radius }}px;
    padding: {{ tab_padding_v }}px {{ tab_padding_h }}px;
    letter-spacing: {{ letter_spacing }}px;
    text-transform: {{ text_transform }};
  }

  #coll-tabs-{{ section_id }} .coll-tabs__item.is-active {
    color: {{ active_text_color }};
    background-color: {{ active_bg_color }};
    border-color: {{ active_border_color }};
    font-weight: {{ active_font_weight }};
  }

  {% if show_divider %}
    #coll-tabs-{{ section_id }} .coll-tabs__item.is-active {
      position: relative;
    }
    #coll-tabs-{{ section_id }} .coll-tabs__item.is-active::after {
      content: '';
      position: absolute;
      bottom: -{{ tab_padding_v | plus: divider_height }}px;
      left: 0;
      right: 0;
      height: {{ divider_height }}px;
      background-color: {{ divider_color }};
    }
  {% endif %}

  @media (max-width: 768px) {
    #coll-tabs-{{ section_id }} .coll-tabs__inner {
      justify-content: start !important;
      gap: {{ tabs_gap_mobile }}px !important;
    }

    #coll-tabs-{{ section_id }} .coll-tabs__item {
      font-size: {{ font_size_mobile }}px;
      padding: {{ tab_padding_v_mobile }}px {{ tab_padding_h_mobile }}px;
    }
  }
</style>

<div class="coll-tabs" id="coll-tabs-{{ section_id }}">
  <div class="coll-tabs__inner">
    {%- for block in section.blocks -%}
      {%- if block.settings.tab_label != blank -%}
        {%- liquid
          assign tab_url = block.settings.tab_link | default: '#'
          assign is_active = false
          if tab_url == request.path
            assign is_active = true
          endif
        -%}
        <a href="{{ tab_url }}" class="coll-tabs__item{% if is_active %} is-active{% endif %}" data-tab-url="{{ tab_url }}">
          {%- if block.settings.tab_icon != blank -%}<span class="coll-tabs__icon">{{ block.settings.tab_icon }}</span>{%- endif -%}
          <span class="coll-tabs__label">{{ block.settings.tab_label }}</span>
          {%- if block.settings.tab_count != blank -%}<span class="coll-tabs__count">({{ block.settings.tab_count }})</span>{%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('coll-tabs-{{ section_id }}');
    if (!section) return;
    var tabs = section.querySelectorAll('.coll-tabs__item');
    var currentPath = window.location.pathname;
    tabs.forEach(function(tab) {
      var tabUrl = tab.getAttribute('data-tab-url');
      if (tabUrl && tabUrl !== '#' && currentPath === tabUrl) {
        tab.classList.add('is-active');
      } else if (tabUrl !== '#') {
        tab.classList.remove('is-active');
      }
    });
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
      });
    });
  })();
</script>

{%- endif -%}

{% stylesheet %}
.coll-tabs {
  width: 100%;
}

.coll-tabs__inner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 0 auto;
  padding: 0 5vw;
}

.coll-tabs__item {
  text-decoration: none;
  transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  position: relative;
  cursor: pointer;
}

.coll-tabs__icon {
  font-size: 1em;
  line-height: 1;
}

.coll-tabs__count {
  opacity: 0.6;
  font-size: 0.85em;
}

@media (max-width: 768px) {
  .coll-tabs__inner {
    overflow-x: auto;
    flex-wrap: nowrap;
    padding: 0 4vw;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .coll-tabs__inner::-webkit-scrollbar {
    display: none;
  }

  .coll-tabs__item {
    flex-shrink: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Tabs",
  "tag": "section",
  "class": "section-collection-tabs",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout — Desktop"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "flex-start", "label": "Left" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Max Container Width",
      "min": 800,
      "max": 1800,
      "step": 40,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "tabs_gap",
      "label": "Gap Between Tabs",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout — Mobile"
    },
    {
      "type": "range",
      "id": "tabs_gap_mobile",
      "label": "Gap Between Tabs",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Background & Border"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Bottom Border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom Border Color",
      "default": "#e8e8e8"
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Border Thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Active Tab Underline",
      "default": false,
      "info": "Colored line under active tab"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Active Underline Color",
      "default": "#872828"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (Desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size (Mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter Spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Case",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "lowercase", "label": "lowercase" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Tab Size — Desktop"
    },
    {
      "type": "range",
      "id": "tab_padding_v",
      "label": "Padding Top/Bottom",
      "min": 4,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "tab_padding_h",
      "label": "Padding Left/Right",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Tab Size — Mobile"
    },
    {
      "type": "range",
      "id": "tab_padding_v_mobile",
      "label": "Padding Top/Bottom",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "tab_padding_h_mobile",
      "label": "Padding Left/Right",
      "min": 6,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Tab Shape"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Tab Border"
    },
    {
      "type": "checkbox",
      "id": "show_tab_border",
      "label": "Show Tab Border",
      "default": true
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Tab Colors — Normal"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Text Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Border Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Tab Colors — Active"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Text Color",
      "default": "#872828"
    },
    {
      "type": "color",
      "id": "active_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Border Color",
      "default": "#872828"
    },
    {
      "type": "select",
      "id": "active_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Text",
          "default": "Shop All"
        },
        {
          "type": "url",
          "id": "tab_link",
          "label": "Tab Link"
        },
        {
          "type": "text",
          "id": "tab_icon",
          "label": "Icon / Emoji (optional)",
          "info": "Paste an emoji e.g. 🛍️"
        },
        {
          "type": "text",
          "id": "tab_count",
          "label": "Count (optional)",
          "info": "e.g. 24 — shows as (24)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Shop All" } },
        { "type": "tab", "settings": { "tab_label": "Bundles" } },
        { "type": "tab", "settings": { "tab_label": "Skincare" } },
        { "type": "tab", "settings": { "tab_label": "Haircare" } }
      ]
    }
  ]
}
{% endschema %}
